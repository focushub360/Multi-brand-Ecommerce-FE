# ==============================================================================
# GROVE Multi-Brand E-Commerce Frontend - Environment Variables Template
# ==============================================================================
# Copy this file to .env.development or .env.production and configure accordingly.
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client code.
# ==============================================================================

# Application Environment (development | production | staging)
VITE_APP_ENV=development

# Application Display Name
VITE_APP_NAME="GROVE Multi-Brand E-Commerce"

# REST API Base URL
# - Local Dev (Direct or via Vite proxy): http://localhost:5000/api/v1 (or /api/v1)
# - Production (Detached backend): https://api.yourdomain.com/api/v1
VITE_API_URL=

# Optional CDN or Static Assets Base URL (if assets are hosted externally)
# VITE_ASSETS_BASE_URL=https://cdn.yourdomain.com
